#########
# basics
#########
# Mod1 = Alt
# Mod4 = Super (Windows Key)
set $mod Mod4

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# set monitors
set $main DP-1
set $left HDMI-A-1

output $main pos 1920 0 res 2560x1440@165Hz
output $left pos 0 0 res 1920x1080@60Hz

# freesync
output $main adaptive_sync on

set $term alacritty

input * {
    xkb_layout "us"
    xkb_variant "intl"
}

# /home/marcelo/Pictures/2qd1f3r2abta1.jpg
#output "*" bg /home/marcelo/Pictures/2qd1f3r2abta1.jpg fill

exec_always swaybg -i /home/marcelo/Pictures/_bg

##################
# run at startup
# bar, keymap, monitors, network manager, bluetooth, notification
##################
exec swaymsg
exec_always --no-startup-id setxkbmap us intl
exec --no-startup-id nm-applet
#exec --no-startup-id blueman-applet
# notifications
exec --no-startup-id dunst

# IBUS -> I use for key mapping the grave symbol
#exec ibus-daemon -drx

# screen saver
exec_always --no-startup-id xset s 3600
exec_always --no-startup-id xset dpms 0 0 3600

set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema gtk-theme 'Breeze-Dark'
    gsettings set $gnome-schema icon-theme 'Mint-Y-Aqua'
    gsettings set $gnome-schema cursor-theme 'Breeze Light'
    #gsettings set $gnome-schema font-name 'Sans 10'
    gsettings set $gnome-schema font-name 'Roboto Regular 10'
    #gsettings set $gnome-schema monospace-font-name 'Fira Code 10'
    #gsettings set $gnome-schema document-font-name 'Roboto Regular 10'
    gsettings set org.gnome.desktop.wm.preferences titlebar-font 'Roboto Regular 10'
    #gsettings set org.gnome.desktop.wm.preferences button-layout ''
    gsettings set org.gnome.desktop.default-applications.terminal exec $term
    #gsettings set org.gnome.desktop.default-applications.terminal exec-arg ''
}

##################
# font
##################
font pango:DejaVu Sans Mono 9
title_align center
hide_edge_borders both

##################
# keybindings
##################

# reload the configuration file
bindsym $mod+Shift+c reload
# restart inplace (preserves your layout/session, can be used to upgrade)
bindsym $mod+Shift+r restart
# exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# start a terminal
bindsym $mod+Return exec alacritty 

# kill focused window
bindsym $mod+Shift+q kill

# launcher
bindsym $mod+d exec --no-startup-id wofi --show drun
bindsym $mod+t exec wofi --show run

# move focused window
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

#whenever middle mouse button is pushed on titlebar or border, close the window
bindsym --release --border button2 kill

# split in horizontal orientation
bindsym $mod+b split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+Shift+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

bindsym $mod+Shift+s sticky toggle
# put YouTube into fullscreen and execute this for media mode
bindsym $mod+y fullscreen disable; floating enable; resize set 600 400; sticky enable; move window to position 1940 54

# lock screen
bindsym $mod+Shift+Escape exec swaylock -e -c 111111

################## end keybindigs

